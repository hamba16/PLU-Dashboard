NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Use the dedicated plu_app login over Supavisor; require verified TLS.
DATABASE_URL=postgresql://plu_app.project-ref:password@pooler-host:5432/postgres?sslmode=verify-full
# Generate 32 random bytes in base64; retain securely for NIN decryption/backups.
NIN_ENCRYPTION_KEY=
# Comma-separated exact browser origins. Include the production Vercel URL when deploying.
APP_ORIGIN=http://127.0.0.1:3000
# Replace re_xxxxxxxxx with your real Resend API key.
RESEND_API_KEY=re_xxxxxxxxx
# Use a verified Resend sender, for example PLU <no-reply@your-domain.com>.
RESEND_FROM_EMAIL=
# Exactly four distinct, individually checked inboxes. No invented addresses.
SEED_REGISTRATION_EMAIL=
SEED_APPROVAL_EMAIL=
SEED_ADMIN_READONLY_EMAIL=
SEED_ADMIN_FULL_EMAIL=
