{
  "name": "plu-youth-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check:supabase": "node --env-file=.env.local scripts/check-supabase.mjs",
    "test:integration": "node --conditions=react-server --import tsx --test tests/security.integration.ts",
    "seed:test": "node --env-file=.env.local scripts/seed-test-accounts.mjs",
    "seed:system-admin": "node --env-file=.env.local scripts/seed-system-admin.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
